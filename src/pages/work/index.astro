---
import { getCollection } from "astro:content"
import Base from "../../layouts/Base.astro"
import CaseCard from "../../components/CaseCard.astro"

const cases = (await getCollection("cases")).sort((a, b) => a.data.order - b.data.order)
---

<Base title="Work" description="Selected case studies by Tas Guerci Maia.">
  <div class="content-mw w-full px-3 pt-44 md:px-0 md:pt-44">
    <h1 class="mb-12 text-3xl font-normal md:text-5xl">Work</h1>
    {
      cases.map((c) => (
        <CaseCard
          company={c.data.company}
          year={c.data.year}
          title={c.data.title}
          cover={c.data.cover}
          coverAlt={c.data.coverAlt}
          coverBg={c.data.coverBg}
          coverSize={c.data.coverSize}
          coverAnchor={c.data.coverAnchor}
          href={c.data.status === "published" ? `/work/${c.id}` : undefined}
          cta={c.data.status === "published" ? "view case →" : "Soon"}
        />
      ))
    }
  </div>
</Base>
