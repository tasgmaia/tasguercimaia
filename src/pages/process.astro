---
import Base from "../layouts/Base.astro"

// Página em construção: só a estrutura. Remova `noindex` quando o conteúdo estiver pronto.
const sections = [
  { title: "Principles and decisions", note: "[How I decide: to be written]" },
  { title: "Process, tied to cases", note: "[Each step linked to the case that proves it: to be written]" },
  { title: "Leading design teams", note: "[How I lead: to be written]" },
]
---

<Base title="How I design" description="How Tas Guerci Maia designs: principles, process and leadership." noindex>
  <div class="content-mw w-full px-3 pt-44 md:px-0 md:pt-44">
    <h1 class="mb-12 text-3xl font-normal md:text-5xl">How I design</h1>
    <div class="flex flex-col gap-12">
      {
        sections.map((s) => (
          <section class="max-w-2xl">
            <h2 class="mb-2 text-xl font-normal md:text-3xl">{s.title}</h2>
            <p class="font-sans text-gray-d">{s.note}</p>
          </section>
        ))
      }
    </div>
  </div>
</Base>
