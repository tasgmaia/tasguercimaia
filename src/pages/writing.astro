---
import Base from "../layouts/Base.astro"
import ArticleItem from "../components/ArticleItem.astro"
import { articles } from "../data/articles"
---

<Base title="Writing" description="Articles by Tas Guerci Maia on design, information architecture and design culture.">
  <div class="content-mw w-full px-3 pt-44 md:px-0 md:pt-44">
    <h1 class="mb-4 text-3xl font-normal md:text-5xl">Writing</h1>
    <p class="mb-12 max-w-2xl font-sans text-lg leading-relaxed">
      Over the years I spent sometime sharing what I've learned and thought about design. For more, check my
      <a class="underline-link" href="https://medium.com/@tasguerci" target="_blank" rel="noreferrer">Medium</a>.
    </p>
    <div class="flex max-w-2xl flex-col gap-6">
      {articles.map((a) => <ArticleItem {...a} />)}
    </div>
  </div>
</Base>
