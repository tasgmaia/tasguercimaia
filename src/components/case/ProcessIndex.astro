---
interface Props {
  label?: string
  items: { text: string; href: string }[]
}
const { label = "Process", items } = Astro.props
---

<nav aria-label={label} class="mt-16 w-full bg-gray-a py-10 md:mt-24 md:py-14">
  <div class="mx-auto w-full max-w-[800px] px-4">
    <p class="m-0 font-sans text-gray-d">{label}</p>
    <ul class="mt-4 mb-0 list-disc pl-5">
      {
        items.map((item) => (
          <li class="my-2 text-lg md:text-xl">
            <a href={item.href} class="underline-link text-ink">
              {item.text}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</nav>
