---
interface Props {
  steps: string[]
}
const { steps } = Astro.props
---

<section class="bg-ac2 text-paper">
  <div class="content-mw px-4 py-24 md:px-8">
    <p class="font-sans text-gray-c">Process</p>
    <ol class="m-0 flex list-none flex-col gap-6 p-0 md:flex-row md:items-center md:gap-0">
      {
        steps.map((step, i) => (
          <>
            {i > 0 && <li aria-hidden="true" class="hidden h-px w-[135px] shrink-0 bg-paper md:block" />}
            <li class="m-0 text-xl leading-tight md:text-4xl">{step}</li>
          </>
        ))
      }
    </ol>
  </div>
</section>
