---
import { Image } from "astro:assets"
import type { ImageMetadata } from "astro"

interface Props {
  image: ImageMetadata
  alt: string
}
const { image, alt } = Astro.props
---

<!-- Faixa de largura total. A cor de fundo vem da própria imagem. -->
<div class="w-full">
  <Image src={image} alt={alt} widths={[800, 1440, 2000]} sizes="100vw" loading="eager" class="block h-auto w-full" />
</div>
