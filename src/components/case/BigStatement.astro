---
interface Props {
  label: string
  statement: string
  col1?: string
  col2?: string
  col3?: string
  bg?: string
}
const { label, statement, col1, col2, col3, bg = "transparent" } = Astro.props
const cols = [col1, col2, col3].filter(Boolean)
---

<section style={`background-color:${bg}`}>
  <div class="content-mw flex items-center py-24">
    <div class="mx-auto p-4 md:p-8">
      <p class="m-0 px-0 font-sans text-gray-d">{label}</p>
      <h2 class="mt-0 mb-8 max-w-3xl pt-1 text-xl leading-tight font-normal md:text-3xl">{statement}</h2>
      <div class="flex flex-col gap-6 md:flex-row md:gap-8">
        {cols.map((c) => <p class="m-0 font-sans text-sm leading-relaxed md:w-1/3 md:text-base">{c}</p>)}
      </div>
    </div>
  </div>
</section>
