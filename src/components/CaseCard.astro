---
import { Image } from "astro:assets"
import type { ImageMetadata } from "astro"

interface Props {
  company: string
  year: number
  title: string
  cover: ImageMetadata
  coverAlt?: string
  coverBg: string
  coverSize?: string
  coverAnchor?: "top" | "bottom"
  /** Sem `href` o card não é clicável. */
  href?: string
  cta: string
}

const { company, year, title, cover, coverAlt = "", coverBg, coverSize = "50%", coverAnchor = "top", href, cta } = Astro.props
const Tag = href ? "a" : "div"
---

<Tag href={href} class:list={["mb-16 block text-ink no-underline md:mb-24", href && "transition-colors duration-200 hover:text-ac1 focus-visible:text-ac1"]}>
  <div
    class:list={["flex h-[250px] w-full justify-center overflow-hidden md:h-[500px]", coverAnchor === "top" ? "items-start pt-8 md:pt-[60px]" : "items-end"]}
    style={`background-color:${coverBg}`}
  >
    <Image src={cover} alt={coverAlt} width={1200} style={`width:${coverSize};height:auto`} />
  </div>
  <div class="mt-6 w-full px-4 md:w-1/3 md:px-0">
    <div class="my-1 font-sans text-base md:text-lg">{company} {year}</div>
    <div class="text-xl leading-relaxed md:text-2xl">{title}</div>
    <div class="my-1 text-lg">{cta}</div>
  </div>
</Tag>
